<!DOCTYPE html>
<html>
  <head>
    <title>ReactOnRailsPoc</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-100 min-h-screen flex flex-col">
      <div class="container mx-auto px-4">
      <% flash.each do |key, message| %>
        <div class="flash-message mb-4 p-4 rounded-lg text-white <%= flash_class(key) %>">
          <%= message %>
        </div>
      <% end %>
    </div>
    <h1 class="existing-css mx-auto">This comes from Rails .erb</h1>
    <div class="container mx-auto p-4 max-w-md">
      <% if rodauth.logged_in? %>
        <div class="bg-white shadow-lg rounded-lg p-4">
          <button type="button" class="text-sm font-medium text-gray-700 hover:text-gray-900 focus:outline-none">
            <%= current_account.email %>
          </button>
          <div class="mt-2 space-y-2">
            <%= link_to "Change password", rodauth.change_password_path, class: "block text-blue-600 hover:underline" %>
            <%= link_to "Change email", rodauth.change_login_path, class: "block text-blue-600 hover:underline" %>
            <div class="border-t border-gray-200 my-2"></div>
            <%= link_to "Close account", rodauth.close_account_path, class: "block text-red-600 hover:underline" %>
            <%= link_to "Sign out", rodauth.logout_path, data: { turbo_method: :post }, class: "block text-red-600 hover:underline" %>
          </div>
        </div>
      <% else %>
        <div class="bg-white shadow-lg rounded-lg p-4 space-x-4">
          <%= link_to "Sign in", rodauth.login_path, class: "text-blue-600 hover:underline" %>
          <%= link_to "Sign up", rodauth.create_account_path, class: "text-blue-600 hover:underline" %>
        </div>
      <% end %>
    </div>
    <div class="flex-grow mx-auto">
      <%= yield %>
    </div>
  </body>

</html>
